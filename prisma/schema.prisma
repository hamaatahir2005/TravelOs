generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  AGENCY_MANAGER
  TICKET_AGENT
  VISA_OFFICER
  ACCOUNTANT
}

enum Currency {
  USD
  IQD
}

model Agency {
  id              String            @id @default(cuid())
  name            String
  isDemo          Boolean           @default(false)
  address         String            @default("")
  phone           String            @default("")
  email           String            @default("")
  logoDocumentId  String?
  receiptHeader   String            @default("Thank you for choosing us. Safe travels!")
  invoicePrefix   String            @default("TOS")
  invoiceSequence Int               @default(1000)
  currency        Currency          @default(USD)
  language        String            @default("en")
  staff           Staff[]
  customers       Customer[]
  suppliers       Supplier[]
  tickets         Ticket[]
  visas           VisaApplication[]
  documents       Document[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  refunds         Refund[]
  cashAccounts    CashAccount[]
  journals        Journal[]
  auditLogs       AuditLog[]
  exchangeRates   ExchangeRate[]
  createdAt       DateTime          @default(now())
}

model Staff {
  id           String    @id @default(cuid())
  agencyId     String
  agency       Agency    @relation(fields: [agencyId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  sessions     Session[]
  createdAt    DateTime  @default(now())

  @@unique([agencyId, id])
}

model Session {
  id        String   @id
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model LoginAttempt {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model Customer {
  id          String            @id @default(cuid())
  agencyId    String
  agency      Agency            @relation(fields: [agencyId], references: [id])
  name        String
  email       String            @default("")
  phone       String
  nationality String            @default("")
  notes       String            @default("")
  tickets     Ticket[]
  visas       VisaApplication[]
  invoices    Invoice[]
  payments    Payment[]
  createdAt   DateTime          @default(now())

  @@unique([agencyId, id])
  @@index([agencyId, name])
}

model Supplier {
  id        String            @id @default(cuid())
  agencyId  String
  agency    Agency            @relation(fields: [agencyId], references: [id])
  name      String
  email     String            @default("")
  phone     String            @default("")
  notes     String            @default("")
  tickets   Ticket[]
  visas     VisaApplication[]
  payments  Payment[]
  createdAt DateTime          @default(now())

  @@unique([agencyId, id])
}

model Ticket {
  id            String     @id @default(cuid())
  agencyId      String
  agency        Agency     @relation(fields: [agencyId], references: [id])
  customerId    String
  customer      Customer   @relation(fields: [agencyId, customerId], references: [agencyId, id])
  supplierId    String
  supplier      Supplier   @relation(fields: [agencyId, supplierId], references: [agencyId, id])
  passengerName String
  airline       String
  origin        String
  destination   String
  departureAt   DateTime
  arrivalAt     DateTime
  pnr           String
  ticketNumber  String
  purchasePrice Decimal    @db.Decimal(18, 2)
  sellingPrice  Decimal    @db.Decimal(18, 2)
  serviceFee    Decimal    @default(0) @db.Decimal(18, 2)
  exchangeRate  Decimal    @db.Decimal(18, 6)
  currency      Currency   @default(USD)
  status        String     @default("CONFIRMED")
  notes         String     @default("")
  documents     Document[]
  invoices      Invoice[]
  refunds       Refund[]
  createdAt     DateTime   @default(now())

  @@unique([agencyId, id])
  @@unique([agencyId, ticketNumber])
  @@index([agencyId, departureAt])
}

model VisaApplication {
  id                String            @id @default(cuid())
  agencyId          String
  agency            Agency            @relation(fields: [agencyId], references: [id])
  customerId        String
  customer          Customer          @relation(fields: [agencyId, customerId], references: [agencyId, id])
  supplierId        String
  supplier          Supplier          @relation(fields: [agencyId, supplierId], references: [agencyId, id])
  country           String
  visaType          String
  passportEncrypted String
  passportExpiry    DateTime
  applicationDate   DateTime          @default(now())
  submissionDate    DateTime?
  reminderAt        DateTime?
  status            String            @default("DRAFT")
  requiredDocuments String[]
  supplierFee       Decimal           @db.Decimal(18, 2)
  governmentFee     Decimal           @default(0) @db.Decimal(18, 2)
  sellingPrice      Decimal           @db.Decimal(18, 2)
  exchangeRate      Decimal           @db.Decimal(18, 6)
  currency          Currency          @default(USD)
  notes             String            @default("")
  timeline          VisaStatusEvent[]
  documents         Document[]
  invoices          Invoice[]
  refunds           Refund[]
  createdAt         DateTime          @default(now())

  @@unique([agencyId, id])
  @@index([agencyId, status])
}

model VisaStatusEvent {
  id        String          @id @default(cuid())
  agencyId  String
  visaId    String
  visa      VisaApplication @relation(fields: [agencyId, visaId], references: [agencyId, id])
  status    String
  note      String          @default("")
  actorId   String
  createdAt DateTime        @default(now())
}

model Document {
  encryptedContent Bytes
  id               String           @id @default(cuid())
  agencyId         String
  agency           Agency           @relation(fields: [agencyId], references: [id])
  ticketId         String?
  ticket           Ticket?          @relation(fields: [agencyId, ticketId], references: [agencyId, id])
  visaId           String?
  visa             VisaApplication? @relation(fields: [agencyId, visaId], references: [agencyId, id])
  name             String
  mimeType         String
  size             Int
  storageKey       String           @unique
  sha256           String
  createdAt        DateTime         @default(now())

  @@unique([agencyId, id])
}

model Invoice {
  ledgerEntries LedgerEntry[]
  id            String           @id @default(cuid())
  agencyId      String
  agency        Agency           @relation(fields: [agencyId], references: [id])
  customerId    String
  customer      Customer         @relation(fields: [agencyId, customerId], references: [agencyId, id])
  ticketId      String?
  ticket        Ticket?          @relation(fields: [agencyId, ticketId], references: [agencyId, id])
  visaId        String?
  visa          VisaApplication? @relation(fields: [agencyId, visaId], references: [agencyId, id])
  number        String
  description   String
  total         Decimal          @db.Decimal(18, 2)
  currency      Currency
  exchangeRate  Decimal          @db.Decimal(18, 6)
  dueAt         DateTime
  payments      Payment[]
  refunds       Refund[]
  createdAt     DateTime         @default(now())

  @@unique([agencyId, id])
  @@unique([agencyId, number])
  @@unique([agencyId, ticketId])
  @@unique([agencyId, visaId])
}

model CashAccount {
  id        String    @id @default(cuid())
  agencyId  String
  agency    Agency    @relation(fields: [agencyId], references: [id])
  name      String
  currency  Currency
  payments  Payment[]
  expenses  Expense[]
  refunds   Refund[]
  createdAt DateTime  @default(now())

  @@unique([agencyId, id])
  @@unique([agencyId, name])
}

model Payment {
  id            String      @id @default(cuid())
  agencyId      String
  agency        Agency      @relation(fields: [agencyId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [agencyId, customerId], references: [agencyId, id])
  supplierId    String?
  supplier      Supplier?   @relation(fields: [agencyId, supplierId], references: [agencyId, id])
  invoiceId     String?
  invoice       Invoice?    @relation(fields: [agencyId, invoiceId], references: [agencyId, id])
  cashAccountId String
  cashAccount   CashAccount @relation(fields: [agencyId, cashAccountId], references: [agencyId, id])
  amount        Decimal     @db.Decimal(18, 2)
  currency      Currency
  exchangeRate  Decimal     @db.Decimal(18, 6)
  direction     String
  reference     String
  createdAt     DateTime    @default(now())

  @@index([agencyId, createdAt])
}

model Expense {
  id            String      @id @default(cuid())
  agencyId      String
  agency        Agency      @relation(fields: [agencyId], references: [id])
  cashAccountId String
  cashAccount   CashAccount @relation(fields: [agencyId, cashAccountId], references: [agencyId, id])
  category      String
  description   String
  amount        Decimal     @db.Decimal(18, 2)
  currency      Currency
  exchangeRate  Decimal     @db.Decimal(18, 6)
  date          DateTime
  createdAt     DateTime    @default(now())

  @@index([agencyId, date])
}

model Refund {
  id            String           @id @default(cuid())
  agencyId      String
  agency        Agency           @relation(fields: [agencyId], references: [id])
  invoiceId     String
  invoice       Invoice          @relation(fields: [agencyId, invoiceId], references: [agencyId, id])
  ticketId      String?
  ticket        Ticket?          @relation(fields: [agencyId, ticketId], references: [agencyId, id])
  visaId        String?
  visa          VisaApplication? @relation(fields: [agencyId, visaId], references: [agencyId, id])
  cashAccountId String?
  cashAccount   CashAccount?     @relation(fields: [agencyId, cashAccountId], references: [agencyId, id])
  amount        Decimal          @db.Decimal(18, 2)
  currency      Currency
  reason        String
  createdAt     DateTime         @default(now())

  @@index([agencyId, createdAt])
}

model Journal {
  id          String        @id @default(cuid())
  agencyId    String
  agency      Agency        @relation(fields: [agencyId], references: [id])
  reference   String
  description String
  actorId     String
  entries     LedgerEntry[]
  createdAt   DateTime      @default(now())

  @@unique([agencyId, id])
  @@index([agencyId, createdAt])
}

model LedgerEntry {
  sourceInvoiceId String?
  sourceInvoice   Invoice? @relation(fields: [agencyId, sourceInvoiceId], references: [agencyId, id])
  id              String   @id @default(cuid())
  agencyId        String
  journalId       String
  journal         Journal  @relation(fields: [agencyId, journalId], references: [agencyId, id])
  account         String
  partyId         String?
  debit           Decimal  @default(0) @db.Decimal(18, 2)
  credit          Decimal  @default(0) @db.Decimal(18, 2)
  currency        Currency
  exchangeRate    Decimal  @db.Decimal(18, 6)
  baseDebit       Decimal  @default(0) @db.Decimal(18, 2)
  baseCredit      Decimal  @default(0) @db.Decimal(18, 2)

  @@index([agencyId, account])
}

model AuditLog {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  actorId   String
  action    String
  entity    String
  entityId  String
  metadata  Json
  createdAt DateTime @default(now())

  @@index([agencyId, createdAt])
}

model ExchangeRate {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  currency    Currency
  unitsPerUsd Decimal  @db.Decimal(18, 6)
  effectiveAt DateTime @default(now())

  @@index([agencyId, currency, effectiveAt])
}
