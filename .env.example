# Copy to .env. Never commit real credentials or reuse these in production.
DATABASE_URL="postgresql://travelos:change-local-password@localhost:5432/travel_os_demo"
POSTGRES_USER="travelos"
POSTGRES_PASSWORD="change-local-password"
POSTGRES_DB="travel_os_demo"
APP_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSPORT_ENCRYPTION_KEY="REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"
# Production: false. Demo must have a separate database (name includes demo).
DEMO_MODE="true"
ALLOW_DEMO_SEED="true"
# Configure development-only credentials before seeding. No default production login.
DEMO_EMAIL="demo@travelos.local"
DEMO_PASSWORD="REPLACE_WITH_A_UNIQUE_12_PLUS_CHARACTER_PASSWORD"
DUFFEL_ENABLED="false"
DUFFEL_ACCESS_TOKEN=""
# Optional: local PostgreSQL integration tests, separate from demo and production.
TEST_DATABASE_URL="postgresql://travelos:change-local-password@localhost:5432/travel_os_test"
